# A complete end-user package always contains the backend and Sony runtime.
if(SONSHELL_BUILD_BACKEND)
  set(SONY_SDK_LICENSE_FILE "" CACHE FILEPATH "Local copy of the Sony SDK license HTML for the binary package")
  if(SONY_SDK_LICENSE_FILE)
    install(FILES "${SONY_SDK_LICENSE_FILE}" DESTINATION ${CMAKE_INSTALL_DATADIR}/doc/sonshell-remote RENAME sony-sdk-license.html)
  endif()
  install(FILES docs/INSTALL.md docs/INSTALL_RU.md
    docs/USER_GUIDE.md docs/USER_GUIDE_RU.md docs/THIRD_PARTY.md docs/THIRD_PARTY_RU.md
    DESTINATION ${CMAKE_INSTALL_DATADIR}/doc/sonshell-remote)
  set(CPACK_GENERATOR DEB)
  set(CPACK_PACKAGE_NAME sonshell-remote)
  set(CPACK_PACKAGE_VERSION ${PROJECT_VERSION})
  set(CPACK_PACKAGE_CONTACT "SonShell Remote maintainers")
  set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Sony camera control, embedded live view and photo transfer")
  set(CPACK_PACKAGING_INSTALL_PREFIX /usr)
  set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
  set(CPACK_DEBIAN_PACKAGE_RELEASE "1ubuntu24.04")
  set(CPACK_DEBIAN_PACKAGE_SECTION graphics)
  set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
  set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS_PRIVATE_DIRS "${CRSDK_ROOT};${CRSDK_ADAPTER}")
  # Qt platform plugins and JPEG are runtime-loaded and do not appear in ELF deps.
  set(CPACK_DEBIAN_PACKAGE_DEPENDS "qt6-qpa-plugins, qt6-image-formats-plugins, libimage-exiftool-perl, qt6-translations-l10n, ffmpeg")
  set(CPACK_DEBIAN_PACKAGE_RECOMMENDS "qt6-gtk-platformtheme")
  set(CPACK_DEBIAN_COMPRESSION_TYPE xz)
  include(CPack)
endif()
